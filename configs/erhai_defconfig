# Source XNU with Apple kexts prelinked (board.toml), booting from a native UFS root.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# The BCM2837 panic buffer address is not mapped on this device.
CONFIG_XNU_DT_PANIC_REGION=y
# The prelink carries com.apple.kec.corecrypto, whose start registers the
# kernel PRNG. "source" also registers it from the source provider, and the
# second registration trips assert(!prng_ready) at early_boot (run-3).
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# CONFIG_XNU_ARMVIRT_PLATFORM is not set
CONFIG_XNU_NATIVE_UFS=y
# UFS root (sheng's chain): NativeAES and NativeVirtioBlock carry the original
# storage ABI that NativeUfsBlock binds to; the owner-verified root and SystemOS
# cache mounts authenticate the userdata windows; ShengPlatformPower publishes
# the original PMGR nub AMFI needs (sheng-pmgr=2). The two *_ARCHIVE bundles are
# built by hand before the kernel step (they need the owner key and policies).
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_SHENG_PMGR=y
# Oryon implements PAN. Without native PAN the kernel leaves SCTLR_EL1.SPAN clear, so every exception
# into EL1 sets PSTATE.PAN and nothing clears it: launchd's exec looped forever on a level-3
# permission fault in copyinstr (ESR 0x9600000f, FAR 0x1000), as sheng's defconfig already avoids.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# CONFIG_XNU_NATIVE_ADRENO is not set
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_EARLY_BOOT_PROGRESS=y
